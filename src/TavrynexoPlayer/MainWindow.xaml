<Window x:Class="TavrynexoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:TavrynexoPlayer.Services"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        FontFamily="{StaticResource UiFont}" Title="Tavrynexo Player" Width="1120" Height="690" MinWidth="760" MinHeight="480"
        Icon="Assets/app.ico" Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Title bar + menu ================= -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="36" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="Assets/logo-small.png" Width="20" Height="20" Margin="12,0,8,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Menu x:Name="MainMenu" Grid.Column="1" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" Focusable="False">
                <MenuItem Header="{svc:Tr m_media}">
                    <MenuItem Header="{svc:Tr open_file}" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                    <MenuItem Header="{svc:Tr add_files}" InputGestureText="Ctrl+Shift+O" Click="AddFiles_Click" />
                    <MenuItem Header="{svc:Tr open_folder}" Click="OpenFolder_Click" />
                    <MenuItem Header="{svc:Tr open_url}" InputGestureText="Ctrl+U" Click="OpenUrl_Click" />
                    <Separator />
                    <MenuItem x:Name="RecentMenu" Header="{svc:Tr recent}" SubmenuOpened="RecentMenu_Opened">
                        <MenuItem Header="{svc:Tr empty}" IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{svc:Tr exit}" InputGestureText="Alt+F4" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_playback}">
                    <MenuItem Header="{svc:Tr play_pause}" InputGestureText="Space" Click="PlayPause_Click" />
                    <MenuItem Header="{svc:Tr stop}" Click="Stop_Click" />
                    <MenuItem Header="{svc:Tr previous}" InputGestureText="P" Click="Prev_Click" />
                    <MenuItem Header="{svc:Tr next}" InputGestureText="N" Click="Next_Click" />
                    <Separator />
                    <MenuItem Header="{svc:Tr fwd10}" Click="Forward10_Click" />
                    <MenuItem Header="{svc:Tr back10}" Click="Back10_Click" />
                    <Separator />
                    <MenuItem Header="{svc:Tr speed}">
                        <MenuItem Header="0.5×" Tag="0.5" Click="Speed_Click" />
                        <MenuItem Header="0.75×" Tag="0.75" Click="Speed_Click" />
                        <MenuItem Header="{svc:Tr normal}" Tag="1" Click="Speed_Click" />
                        <MenuItem Header="1.25×" Tag="1.25" Click="Speed_Click" />
                        <MenuItem Header="1.5×" Tag="1.5" Click="Speed_Click" />
                        <MenuItem Header="2×" Tag="2" Click="Speed_Click" />
                    </MenuItem>
                    <MenuItem Header="{svc:Tr repeat}" InputGestureText="R" Click="Repeat_Click" />
                    <MenuItem Header="{svc:Tr shuffle}" InputGestureText="H" Click="Shuffle_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_audio}">
                    <MenuItem x:Name="AudioTrackMenu" Header="{svc:Tr audio_track}" SubmenuOpened="AudioTrackMenu_Opened">
                        <MenuItem Header="{svc:Tr none}" IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{svc:Tr vol_up}" InputGestureText="↑" Click="VolUp_Click" />
                    <MenuItem Header="{svc:Tr vol_down}" InputGestureText="↓" Click="VolDown_Click" />
                    <MenuItem Header="{svc:Tr mute}" InputGestureText="M" Click="Mute_Click" />
                    <Separator />
                    <MenuItem Header="{svc:Tr adelay_minus}" Click="AudioDelayMinus_Click" />
                    <MenuItem Header="{svc:Tr adelay_plus}" Click="AudioDelayPlus_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_video}">
                    <MenuItem Header="{svc:Tr aspect}">
                        <MenuItem Header="{svc:Tr default}" Tag="" Click="Aspect_Click" />
                        <MenuItem Header="16:9" Tag="16:9" Click="Aspect_Click" />
                        <MenuItem Header="4:3" Tag="4:3" Click="Aspect_Click" />
                        <MenuItem Header="21:9" Tag="21:9" Click="Aspect_Click" />
                        <MenuItem Header="1:1" Tag="1:1" Click="Aspect_Click" />
                    </MenuItem>
                    <MenuItem Header="{svc:Tr fullscreen}" InputGestureText="F" Click="Fullscreen_Click" />
                    <MenuItem Header="{svc:Tr snapshot}" InputGestureText="Ctrl+S" Click="Snapshot_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_subtitle}">
                    <MenuItem Header="{svc:Tr add_sub}" Click="AddSubtitle_Click" />
                    <MenuItem x:Name="SubtitleTrackMenu" Header="{svc:Tr sub_track}" SubmenuOpened="SubtitleTrackMenu_Opened">
                        <MenuItem Header="{svc:Tr none}" IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{svc:Tr sdelay_minus}" Click="SubDelayMinus_Click" />
                    <MenuItem Header="{svc:Tr sdelay_plus}" Click="SubDelayPlus_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_view}">
                    <MenuItem x:Name="PlaylistMenuItem" Header="{svc:Tr playlist}" InputGestureText="Ctrl+L" Click="Playlist_Click" />
                    <MenuItem x:Name="TopmostMenuItem" Header="{svc:Tr on_top}" IsCheckable="True" Click="Topmost_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_settings}">
                    <MenuItem Header="{svc:Tr language}" Click="Language_Click" />
                </MenuItem>
                <MenuItem Header="{svc:Tr m_help}">
                    <MenuItem Header="{svc:Tr help_github}" Click="GitHub_Click" />
                    <MenuItem Header="{svc:Tr help_contact}" Click="Contact_Click" />
                    <Separator />
                    <MenuItem Header="{svc:Tr shortcuts}" Click="Shortcuts_Click" />
                    <MenuItem Header="{svc:Tr about}" Click="About_Click" />
                </MenuItem>
            </Menu>

            <TextBlock x:Name="TitleText" Grid.Column="2" Text="Tavrynexo Player" Foreground="{StaticResource TextDimBrush}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="16,0" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= Video + playlist ================= -->
        <Grid Grid.Row="1" Background="Black">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <vlc:VideoView x:Name="VideoView" Background="Black">
                <Grid x:Name="Overlay" Background="#FF0B0D14" AllowDrop="True"
                      MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove"
                      MouseWheel="Overlay_MouseWheel" Drop="Window_Drop" DragOver="Window_DragOver">

                    <!-- Idle splash -->
                    <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="Assets/logo.png" Width="132" Height="132" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Tavrynexo" Foreground="White" FontSize="34" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="P L A Y E R" Foreground="{StaticResource Accent2Brush}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{svc:Tr drop_hint}" Foreground="{StaticResource TextDimBrush}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,28,0,14" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="{svc:Tr btn_open_file}" Click="OpenFile_Click" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostButton}" Content="{svc:Tr btn_open_url}" Click="OpenUrl_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Audio-only panel -->
                    <StackPanel x:Name="AudioPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Image Source="Assets/logo.png" Width="110" Height="110" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="AudioTitle" Foreground="White" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" MaxWidth="640" />
                    </StackPanel>

                    <!-- OSD -->
                    <Border x:Name="OsdBorder" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,18,18,0" Padding="16,9" CornerRadius="10" Background="#CC12151F"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                        <TextBlock x:Name="OsdText" Foreground="White" FontSize="15" />
                    </Border>
                </Grid>
            </vlc:VideoView>

            <!-- Playlist panel -->
            <Border x:Name="PlaylistPanel" Grid.Column="1" Width="310" Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,10,8,6">
                        <TextBlock Text="{svc:Tr playlist}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Content="&#xE710;"
                                    ToolTip="{svc:Tr add_files}" Click="AddFiles_Click" />
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" FontSize="14" Content="&#xE74D;"
                                    ToolTip="{svc:Tr clear_playlist}" Click="ClearPlaylist_Click" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="PlaylistList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlaylistItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PlaylistList_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Ind" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="Ttl" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Ttl" Property="Foreground" Value="{StaticResource Accent2Brush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Control bar ================= -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="14,8,14,10">
            <StackPanel>
                <Grid Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTime" Text="0:00" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                               VerticalAlignment="Center" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource PlayerSlider}"
                            Minimum="0" Maximum="1000" ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock x:Name="TotalTime" Grid.Column="2" Text="0:00" Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Content="&#xE768;" Click="PlayPause_Click"
                                Margin="0,0,10,0" ToolTip="{svc:Tr play_pause}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="{svc:Tr previous}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Click="Stop_Click" ToolTip="{svc:Tr stop}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="{svc:Tr next}" />
                        <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrush2}" Margin="8,0" />
                        <ToggleButton x:Name="ShuffleButton" Style="{StaticResource IconToggle}" Content="&#xE8B1;"
                                      Click="ShuffleButton_Click" ToolTip="{svc:Tr shuffle}" />
                        <ToggleButton x:Name="RepeatButton" Style="{StaticResource IconToggle}" Content="&#xE8EE;"
                                      Click="RepeatButton_Click" ToolTip="{svc:Tr repeat}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Width="52" FontFamily="{StaticResource UiFont}"
                                FontSize="12" Content="1.0×" Click="SpeedButton_Click" ToolTip="{svc:Tr tt_speed}" />
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="{svc:Tr mute}" />
                        <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="100" Minimum="0" Maximum="100"
                                Value="80" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="VolumeText" Text="80%" Foreground="{StaticResource TextDimBrush}" FontSize="12" Width="44"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ToggleButton x:Name="PlaylistButton" Style="{StaticResource IconToggle}" Content="&#xE8FD;"
                                      Click="Playlist_Click" ToolTip="{svc:Tr playlist}" />
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                Click="Fullscreen_Click" ToolTip="{svc:Tr fullscreen}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

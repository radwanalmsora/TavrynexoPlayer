<Window x:Class="TavrynexoPlayer.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="520" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Tavrynexo Player">
    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Header_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="28,26,28,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubText" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="BodyText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                       LineHeight="22" Margin="0,22,0,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Close" IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,24,0,0" Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>

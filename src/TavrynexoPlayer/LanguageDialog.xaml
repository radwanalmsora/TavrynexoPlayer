<Window x:Class="TavrynexoPlayer.LanguageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Width="440" Height="600" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Language">
    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Header_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource DarkTextBox}" Margin="0,14,0,10"
                     Padding="12,8" TextChanged="SearchBox_TextChanged" />
            <ListBox x:Name="LangList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PlaylistItem}" DisplayMemberPath="Display"
                     FontSize="14" MouseDoubleClick="LangList_DoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

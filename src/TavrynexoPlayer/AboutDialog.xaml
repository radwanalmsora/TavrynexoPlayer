<Window x:Class="TavrynexoPlayer.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="540" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="Tavrynexo Player">
    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Header_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="30,28,30,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Tavrynexo Player" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Accent2Brush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="DescText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"
                       LineHeight="21" Margin="0,22,0,18" />

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DevLabel" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,0,18,10" />
                    <TextBlock Grid.Column="1" Text="Radwan Almsora" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock x:Name="MailLabel" Grid.Row="1" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,0,18,10" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" Margin="0,0,0,10" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                        <Hyperlink NavigateUri="mailto:retwan.tech@gmail.com" RequestNavigate="Link_Navigate"
                                   Foreground="{StaticResource Accent2Brush}">retwan.tech@gmail.com</Hyperlink>
                    </TextBlock>

                    <TextBlock x:Name="SrcLabel" Grid.Row="2" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,0,18,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="Wrap">
                        <Hyperlink NavigateUri="https://github.com/radwanalmsora/TavrynexoPlayer" RequestNavigate="Link_Navigate"
                                   Foreground="{StaticResource Accent2Brush}">github.com/radwanalmsora/TavrynexoPlayer</Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>

            <TextBlock x:Name="EngineText" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0" />
            <TextBlock Text="© Radwan Almsora" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,4,0,0" />

            <Button x:Name="CloseBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Right" Margin="0,22,0,0" Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>

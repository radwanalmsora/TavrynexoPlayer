<Window x:Class="TavrynexoPlayer.UrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="Height" Width="560" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Title="Open Network Stream">
    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Header_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="26,22,26,22">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="HintText" Foreground="{StaticResource TextDimBrush}"
                       FontSize="12.5" Margin="0,4,0,16" />
            <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

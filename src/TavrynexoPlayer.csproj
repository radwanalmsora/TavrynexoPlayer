<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TavrynexoPlayer</RootNamespace>
    <AssemblyName>TavrynexoPlayer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>1.0.0</Version>
    <Company>Tavrynexo</Company>
    <Product>Tavrynexo Player</Product>
    <Description>Tavrynexo Player - Modern media player for Windows 10 and 11</Description>
    <Copyright>Copyright (c) Tavrynexo</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.*" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-small.png" />
    <Resource Include="Assets\mark-white.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
